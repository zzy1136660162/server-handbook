{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:server-handbook:service:1",
  "title": "Server Handbook service declaration v1",
  "description": "Portable structural validation. The runtime also checks native absolute paths, configured roots, symlinks, source placement, file contents and HTTP URL semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "kind",
    "state",
    "home",
    "readme"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/serviceId"
    },
    "name": {
      "$ref": "#/$defs/shortText"
    },
    "kind": {
      "enum": [
        "compose",
        "systemd",
        "project",
        "desktop",
        "toolchain"
      ]
    },
    "state": {
      "enum": [
        "prepared",
        "installed",
        "deployed",
        "retired"
      ]
    },
    "home": {
      "$ref": "#/$defs/absolutePath"
    },
    "readme": {
      "allOf": [
        {
          "$ref": "#/$defs/absolutePath"
        },
        {
          "pattern": "\\.[mM][dD]$"
        }
      ]
    },
    "version": {
      "$ref": "#/$defs/shortText"
    },
    "systemd_units": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9@_.:\\\\-]*\\.(service|socket|timer|target|mount|automount|path|slice|scope)$",
        "not": {
          "pattern": "\\s"
        }
      }
    },
    "compose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "service",
        "files"
      ],
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
          "not": {
            "pattern": "\\s"
          }
        },
        "service": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "not": {
            "pattern": "\\s"
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/absolutePath"
          }
        }
      }
    },
    "packages": {
      "$ref": "#/$defs/textArray"
    },
    "local_ports": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bind",
          "port",
          "transport",
          "purpose"
        ],
        "properties": {
          "bind": {
            "$ref": "#/$defs/text"
          },
          "port": {
            "$ref": "#/$defs/port"
          },
          "transport": {
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "purpose": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "remote_endpoints": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "direction",
          "host",
          "port",
          "transport",
          "purpose"
        ],
        "properties": {
          "direction": {
            "enum": [
              "inbound",
              "outbound"
            ]
          },
          "host": {
            "$ref": "#/$defs/text"
          },
          "port": {
            "$ref": "#/$defs/port"
          },
          "transport": {
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "purpose": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "config_paths": {
      "$ref": "#/$defs/pathArray"
    },
    "data_paths": {
      "$ref": "#/$defs/pathArray"
    },
    "secret_refs": {
      "$ref": "#/$defs/pathArray"
    },
    "depends_on": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/serviceId"
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "description": "Display-only maintenance notes; Server Handbook never executes these strings.",
      "properties": {
        "status": {
          "$ref": "#/$defs/text"
        },
        "start": {
          "$ref": "#/$defs/text"
        },
        "stop": {
          "$ref": "#/$defs/text"
        },
        "restart": {
          "$ref": "#/$defs/text"
        },
        "logs": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "notes": {
      "$ref": "#/$defs/textArray"
    },
    "evidence": {
      "$ref": "#/$defs/pathArray"
    },
    "checks": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "url",
          "expected_status",
          "timeout_seconds"
        ],
        "properties": {
          "type": {
            "const": "http"
          },
          "url": {
            "allOf": [
              {
                "$ref": "#/$defs/text"
              }
            ],
            "maxLength": 2048,
            "format": "uri",
            "pattern": "^[hH][tT][tT][pP][sS]?://",
            "not": {
              "anyOf": [
                {
                  "pattern": "\\s"
                },
                {
                  "pattern": "^[hH][tT][tT][pP][sS]?://[^/?#]*@"
                }
              ]
            }
          },
          "expected_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "compose"
          },
          "state": {
            "const": "deployed"
          }
        },
        "required": [
          "kind",
          "state"
        ]
      },
      "then": {
        "required": [
          "compose"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "systemd"
          },
          "state": {
            "const": "deployed"
          }
        },
        "required": [
          "kind",
          "state"
        ]
      },
      "then": {
        "required": [
          "systemd_units"
        ],
        "properties": {
          "systemd_units": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "not": {
            "pattern": "\u0000"
          }
        }
      ]
    },
    "shortText": {
      "allOf": [
        {
          "$ref": "#/$defs/text"
        }
      ],
      "maxLength": 200
    },
    "serviceId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "absolutePath": {
      "allOf": [
        {
          "$ref": "#/$defs/text"
        }
      ],
      "description": "POSIX, Windows drive, or UNC absolute syntax. Native-platform validation and resolved containment are enforced at runtime.",
      "anyOf": [
        {
          "pattern": "^/"
        },
        {
          "pattern": "^[A-Za-z]:[\\\\/]"
        },
        {
          "pattern": "^\\\\"
        }
      ]
    },
    "textArray": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "pathArray": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/absolutePath"
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  }
}
